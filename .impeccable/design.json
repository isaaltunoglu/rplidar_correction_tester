  "narrative": {
    "northStar": "The Field Research Station",
    "overview": "RPLIDAR Lab is a compact local instrument: ink blue navigation frames an offwhite working ground, and a dark plotting surface holds the measurements. The character is calm, precise and practical. Separators, aligned values and restrained color communicate structure without turning every group into a card.\n\nA terracotta angular ribbon and the corresponding plotted sector form the signature. They describe the same software selection; the plotted geometry is evidence-bearing rather than decorative. Locally served Manrope gives controls and measurements one consistent voice. Data source, stale data, disconnected hardware, simulation, replay and pause remain explicit product states.",
    "keyCharacteristics": [
      "Ink blue navigation, offwhite workspaces and a dark measurement canvas.",
      "Compact controls, deliberate dividers and tabular measurement numerals.",
      "A terracotta selection ribbon paired with the plotted angular sector.",
      "Explicit provenance and honest unavailable-data states.",
      "Local assets, visible keyboard focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Source Before Color Rule",
        "body": "Preserve visible source and state text whenever color indicates live data, simulation, replay, recording or missing data.",
        "section": "colors"
      },
      {
        "name": "The Paired Annotation Rule",
        "body": "Keep selection annotations consistent with the plotted sector. Color cannot substitute for the angle values or sector description.",
        "section": "colors"
      },
      {
        "name": "The Aligned Values Rule",
        "body": "Use tabular numerals for measurements, angles, elapsed values and data tables. Keep units visually subordinate without hiding them.",
        "section": "typography"
      },
      {
        "name": "The Flat Instrument Rule",
        "body": "Use borders, spacing and tonal surfaces for persistent structure; reserve the documented soft shadow for transient feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the ink blue rail, paper ground and dark plot as distinct working surfaces.",
      "Do pair source color with visible source text and unavailable-data explanations.",
      "Do keep the angular controls, ribbon values and plotted sector consistent.",
      "Do use locally served Manrope, tabular data numerals and monospace raw cells.",
      "Do preserve visible focus, native labelled inputs and reduced-motion behavior.",
      "Do verify desktop and mobile rendered states before granting visual ship approval."
    ],
    "donts": [
      "Don't fabricate live measurements or add a decorative scanning sweep.",
      "Don't present missing data or a proximity color as a safety conclusion.",
      "Don't turn every measurement group into an elevated card.",
      "Don't substitute glyph characters for the existing SVG icon system.",
      "Don't treat source inspection or DOM tests as a completed browser screenshot review."
    ]
  }
}
